# SpeakAcross local development environment
# Copy this file to .env and add your own key.

OPENAI_API_KEY=

# Optional: override the default OpenAI Realtime models during development.
SPEAKACROSS_TRANSLATION_MODEL=gpt-realtime-translate
SPEAKACROSS_TRANSCRIPTION_MODEL=gpt-live-transcribe
SPEAKACROSS_AGENT_MODEL=gpt-realtime-2.1
SPEAKACROSS_ACCURATE_MODEL=gpt-realtime-2.1
SPEAKACROSS_DEFAULT_MODE=accurate
SPEAKACROSS_ACCURATE_VAD_SILENCE_MS=1200
SPEAKACROSS_FAST_GATE_DBFS=-48
SPEAKACROSS_FAST_GATE_PREROLL_MS=250
SPEAKACROSS_FAST_GATE_HANGOVER_MS=700

# Automated AI <-> AI regression test.
# Explicit acknowledgement is required because these tests use paid OpenAI APIs.
# SPEAKACROSS_ALLOW_PAID_E2E=1
SPEAKACROSS_FULL_E2E_TURNS=6
SPEAKACROSS_FULL_E2E_TIMEOUT_SECONDS=90
SPEAKACROSS_FULL_E2E_MAX_LATENCY_SECONDS=8
# SPEAKACROSS_FULL_E2E_REPORT=/tmp/speakacross-full-e2e-report.json

# Semantic golden-set E2E.
SPEAKACROSS_GOLDEN_JUDGE_MODEL=gpt-5.4-mini
SPEAKACROSS_GOLDEN_ENGINE=fast
SPEAKACROSS_GOLDEN_MIN_SCORE=80
SPEAKACROSS_GOLDEN_MAX_CASES=6
SPEAKACROSS_GOLDEN_REPEAT=1
# SPEAKACROSS_GOLDEN_CASE=zh_rpc_failover
# SPEAKACROSS_GOLDEN_REPORT=/tmp/speakacross-golden-e2e-report.json
